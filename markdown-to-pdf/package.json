{
  "name": "markdown-to-pdf",
  "version": "1.0.0",
  "description": "Convert Markdown files or URLs to beautiful PDFs with themes and live preview",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n \"server,client\" -c \"cyan,magenta\" \"node server/index.js\" \"vite\"",
    "dev:server": "node server/index.js",
    "dev:client": "vite",
    "build": "tsc -b && vite build",
    "start": "node server/index.js"
  },
  "dependencies": {
    "@capacitor/core": "^8.6.0",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/share": "^8.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "highlight.js": "^11.12.0",
    "html2pdf.js": "^0.14.0",
    "katex": "^0.19.1",
    "lucide-react": "^1.64.0",
    "marked": "^18.1.2",
    "mermaid": "^12.2.0",
    "puppeteer-core": "^25.16.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/cli": "^8.6.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/katex": "^0.16.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.2",
    "concurrently": "^10.0.6",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
