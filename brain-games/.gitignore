# ==============================================================================
# MindForge Android App - .gitignore
# ==============================================================================

# Built application files & packages
*.apk
*.aar
*.aab

# Files for the ART/Dalvik VM
*.dex

# Java class files
*.class

# Generated files
bin/
gen/
out/
build/
app/build/

# Gradle files
.gradle/
buildOutputCleanup/

# Local configuration file (sdk path, etc)
local.properties

# Proguard folder generated by Eclipse
proguard/

# Log Files
*.log

# Android Studio Navigation editor temp files
.navigation/

# Android Studio captures folder
captures/

# IntelliJ IDEA
*.iml
.idea/
.idea/caches
.idea/libraries
.idea/modules.xml
.idea/workspace.xml

# Keystore files
*.jks
*.keystore
*.p12

# Google Services credentials
google-services.json

# External native build folder
.cxx/

# Kotlin / KSP
.kotlin/
