<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Anchor" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:windowBackground">@color/oled_black</item>
        <item name="android:colorBackground">@color/oled_black</item>
        <item name="colorSurface">@color/surface_elevated</item>
        <item name="colorSurfaceContainer">@color/surface_card</item>
        <item name="colorSurfaceContainerHigh">@color/surface_card</item>
        <item name="colorSurfaceVariant">@color/surface_card</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorOutline">@color/stroke_subtle</item>
        <item name="colorOutlineVariant">@color/stroke_subtle</item>

        <item name="colorPrimary">@color/accent_emerald</item>
        <item name="colorOnPrimary">@color/on_accent_dark</item>
        <item name="colorPrimaryContainer">@color/accent_surface_tint</item>
        <item name="colorOnPrimaryContainer">@color/accent_emerald</item>
        <item name="colorSecondary">@color/accent_emerald</item>
        <item name="colorOnSecondary">@color/on_accent_dark</item>
        <item name="colorSecondaryContainer">@color/accent_surface_tint</item>
        <item name="colorOnSecondaryContainer">@color/accent_emerald</item>
        <item name="colorError">@color/status_error</item>

        <item name="android:statusBarColor">@color/oled_black</item>
        <item name="android:navigationBarColor">@color/surface_elevated</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="bottomSheetDialogTheme">@style/Theme.Anchor.BottomSheetDialog</item>
    </style>

    <style name="Theme.Anchor.Translucent" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:colorBackgroundCacheHint">@null</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.55</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="colorPrimary">@color/accent_emerald</item>
        <item name="colorOnPrimary">@color/on_accent_dark</item>
        <item name="colorSurface">@color/surface_elevated</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorOutline">@color/stroke_subtle</item>
        <item name="bottomSheetDialogTheme">@style/Theme.Anchor.BottomSheetDialog</item>
    </style>

    <style name="Theme.Anchor.BottomSheetDialog" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.Anchor.BottomSheet.Modal</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/surface_elevated</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
    </style>

    <style name="Widget.Anchor.BottomSheet.Modal" parent="Widget.Material3.BottomSheet.Modal">
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="android:background">@android:color/transparent</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Anchor.BottomSheet</item>
    </style>

    <style name="ShapeAppearance.Anchor.BottomSheet" parent="ShapeAppearance.Material3.Corner.ExtraLarge">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">24dp</item>
        <item name="cornerSizeTopRight">24dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <style name="Widget.Anchor.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/surface_card</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/stroke_subtle</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardCornerRadius">16dp</item>
    </style>

    <style name="Widget.Anchor.FilterChip" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/chip_bg_selector</item>
        <item name="chipStrokeColor">@color/chip_stroke_selector</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="android:textColor">@color/chip_text_selector</item>
        <item name="checkedIconVisible">false</item>
        <item name="chipCornerRadius">100dp</item>
        <item name="chipMinHeight">34dp</item>
    </style>

    <style name="ShapeAppearance.Anchor.Thumbnail" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>
</resources>
