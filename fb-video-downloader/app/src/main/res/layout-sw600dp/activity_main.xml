<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/oled_black">

    <!-- Left Navigation Rail for Foldables & Tablets up to 14.2"+ -->
    <com.google.android.material.navigationrail.NavigationRailView
        android:id="@+id/nav_rail"
        android:layout_width="80dp"
        android:layout_height="0dp"
        android:background="@color/surface_elevated"
        app:itemActiveIndicatorStyle="@null"
        app:itemIconTint="@color/chip_text_selector"
        app:itemRippleColor="@color/accent_surface_tint"
        app:itemTextColor="@color/chip_text_selector"
        app:labelVisibilityMode="labeled"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:menu="@menu/bottom_nav_menu"
        app:menuGravity="top" />

    <View
        android:id="@+id/rail_divider"
        android:layout_width="1dp"
        android:layout_height="0dp"
        android:background="@color/stroke_subtle"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/nav_rail"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Top Toolbar with safe WindowInsets wrapper -->
    <LinearLayout
        android:id="@+id/top_bar_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/surface_elevated"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/rail_divider"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:id="@+id/top_bar"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/page_horizontal_padding">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:contentDescription="@string/app_name"
                android:src="@drawable/ic_anchor_mark" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:letterSpacing="-0.02"
                android:maxLines="1"
                android:text="@string/app_name"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:textStyle="bold" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_auto_download"
                style="@style/Widget.Anchor.FilterChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="true"
                android:text="@string/auto_download_toggle"
                android:textSize="13sp"
                app:chipIcon="@drawable/ic_bolt"
                app:chipIconEnabled="true"
                app:chipIconSize="16dp"
                app:chipIconTint="@color/chip_text_selector" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:id="@+id/top_divider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="@color/stroke_subtle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/rail_divider"
        app:layout_constraintTop_toBottomOf="@id/top_bar_container" />

    <!-- Smart Clipboard Banner (max-width constrained on tablets) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_clipboard_banner"
        style="@style/Widget.Anchor.Card"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/page_horizontal_padding"
        android:layout_marginTop="16dp"
        android:visibility="gone"
        app:cardBackgroundColor="@color/surface_card"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/rail_divider"
        app:layout_constraintTop_toBottomOf="@id/top_divider"
        app:layout_constraintWidth_max="@dimen/content_max_width"
        app:strokeColor="@color/accent_emerald_muted">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp"
            android:paddingVertical="12dp">

            <ImageView
                android:id="@+id/iv_clipboard_platform"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_platform_generic"
                app:tint="@color/accent_emerald" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/clipboard_banner_title"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_clipboard_url"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_clipboard_download"
                style="@style/Widget.Material3.Button"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:backgroundTint="@color/accent_emerald"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:paddingHorizontal="16dp"
                android:text="@string/clipboard_banner_action"
                android:textColor="@color/on_accent_dark"
                android:textSize="13sp"
                android:textStyle="bold"
                app:cornerRadius="100dp" />

            <ImageButton
                android:id="@+id/btn_clipboard_dismiss"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/action_dismiss"
                android:src="@drawable/ic_close"
                app:tint="@color/text_secondary" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Centered Max-Width URL Input Bar -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_input_bar"
        style="@style/Widget.Anchor.Card"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/page_horizontal_padding"
        android:layout_marginTop="16dp"
        app:cardCornerRadius="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/rail_divider"
        app:layout_constraintTop_toBottomOf="@id/card_clipboard_banner"
        app:layout_constraintWidth_max="@dimen/content_max_width">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="54dp"
            android:orientation="horizontal"
            android:paddingStart="@dimen/input_horizontal_padding"
            android:paddingEnd="10dp">

            <EditText
                android:id="@+id/et_url_input"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@null"
                android:ellipsize="end"
                android:hint="@string/hint_paste_url"
                android:imeOptions="actionGo"
                android:importantForAutofill="no"
                android:inputType="textUri"
                android:singleLine="true"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:textSize="15sp" />

            <ImageButton
                android:id="@+id/btn_clear_url"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/action_clear"
                android:src="@drawable/ic_close"
                android:visibility="gone"
                app:tint="@color/text_secondary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_paste_fetch"
                style="@style/Widget.Material3.Button"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginStart="8dp"
                android:backgroundTint="@color/accent_emerald"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:paddingHorizontal="18dp"
                android:text="@string/action_paste_fetch"
                android:textColor="@color/on_accent_dark"
                android:textSize="13sp"
                android:textStyle="bold"
                app:cornerRadius="10dp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Multi-column adaptive content area -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/view_pager"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/rail_divider"
        app:layout_constraintTop_toBottomOf="@id/card_input_bar" />

</androidx.constraintlayout.widget.ConstraintLayout>
