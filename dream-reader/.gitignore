# ==============================================================================
# ReadMaster (Dream Reader) .gitignore
# ==============================================================================

# Environment & Credentials (Zero Secret Leakage)
.env*
!.env.example
*.local
local.properties
*.jks
*.keystore
*.p12
*.pem
*.key
id_rsa
id_rsa.pub
credentials.json
google-services.json

# Build Artifacts & Package Manager Outputs
node_modules/
dist/
dist-ssr/
build/
**/build/
out/
target/
.gradle/
**/.gradle/
.cxx/
**/.cxx/
.vercel/
**/.vercel/
.turbo/
*.class
*.dex
*.apk
*.aab
*.ap_

# Logs & Diagnostics
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# OS Caches & System Metas
.DS_Store
**/.DS_Store
Thumbs.db
ehthumbs.db

# IDE, Editor & Workspace Files
.vscode/*
!.vscode/extensions.json
.idea/
**/.idea/
*.iml
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp
*.swo
*~
