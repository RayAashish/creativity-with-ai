# ==============================================================================
# ReadMaster / Lipi — Environment Configuration Template
# ==============================================================================

# API Base URL for Translation & Sync Services (Vite Frontend)
VITE_TRANSLATION_API_URL=http://localhost:3050
VITE_SYNC_API_URL=http://localhost:3050

# Node.js Server Port (Backend & Proxy)
PORT=3050

# Optional Gemini API Key for "Explain This" AI Assistant
# If omitted, ReadMaster falls back to the built-in offline technical heuristic explainer
GEMINI_API_KEY=your_gemini_api_key_here

# Optional PostgreSQL Connection String for Cloud Sync (Phase 5)
DATABASE_URL=postgresql://readmaster:readmaster_secret@localhost:5432/readmaster_db

# Vercel Environment (automatically injected in production)
# VERCEL_ENV=production
