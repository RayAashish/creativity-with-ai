# Google OAuth 2.0 Configuration (Optional overrides for custom Google Drive cloud sync)
GOOGLE_DRIVE_CLIENT_ID=your_client_id_here.apps.googleusercontent.com
GOOGLE_DRIVE_REDIRECT_URI=https://developers.google.com/oauthplayground

# Application Environment Configuration
INKFLOW_DEBUG_LOGGING=false
INKFLOW_HIGH_REFRESH_RATE_ENABLED=true
